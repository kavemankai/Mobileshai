{
  "name": "the-last-check-in",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "test": "vitest run",
    "e2e": "node tests/e2e.mjs",
    "check": "npm run build && npm run build:single && npm test && npm run e2e"
  },
  "devDependencies": {
    "playwright": "1.64.1",
    "typescript": "~5.9.3",
    "vite": "~7.3.7",
    "vite-plugin-singlefile": "~2.3.0",
    "vitest": "~3.2.7"
  }
}
